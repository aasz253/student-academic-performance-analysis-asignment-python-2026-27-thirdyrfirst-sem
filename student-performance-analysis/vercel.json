{
  "framework": "python",
  "python": {
    "runtime": "python3.11"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "routes": [
    {
      "source": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "source": "/(.*)",
      "dest": "/index.html"
    }
  ]
}